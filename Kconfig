mainmenu "CubeMot Configuration"

# Project General Options
config PROJECT_NAME
    string "Project Name"
    default "CubeMot"

config PROJECT_VERSION
    string "Project Version"
    default "1.0.0"

# Load board selection menu
source "src/boards/Kconfig"

# Load feature module configurations
source "src/drivers/Kconfig"
source "src/modules/Kconfig"

# Application layer configuration
config APP_AUTO_START
    bool "Auto Start Application"
    default y
    help
        Automatically start application after initialization

config APP_STARTUP_DELAY_MS
    int "Startup Delay (ms)"
    default 1000
    range 0 10000
    help
        Delay before starting application after initialization

config APP_ENABLE_DEBUG
    bool "Enable Debug Mode"
    default n
    help
        Enable application debug features
