config MODULE_SERIAL_CMD_ENABLE
	bool "Serial Command Module"
	default y
	help
	  Enables UART serial command protocol bridge (UART ↔ msghub).
	  USART2 @ 115200 baud, binary frame protocol.

if MODULE_SERIAL_CMD_ENABLE

config SERIAL_CMD_STACK_SIZE
	int "Serial command thread stack size (bytes)"
	default 1536
	range 1024 8192
	help
	  Stack size for the unified serial command thread (RX + TX).

endif # MODULE_SERIAL_CMD_ENABLE
