#!/bin/bash
# Refer to: https://git-scm.com/docs/githooks#_pre_commit

set -e

check_c_cpp_format() {
  if ! command -v git-clang-format &> /dev/null; then
    echo "⚠️  [pre-commit hook] Warning: git-clang-format not found. Skipping C/C++ format check." >&2
    return 0
  fi

  echo "🔍 [pre-commit hook] Checking C/C++ format..."

  # Note: git-clang-format does not support .clang-format-ignore.
  # To exclude specific directories from formatting, create a .clang-format file
  # in those directories with the following content:
  #     DisableFormat: true

  if ! output=$(git clang-format --staged --diffstat --style=file --extensions c,h,cpp,hpp,cc,cxx,c++,h++,hh 2>&1); then
    echo ""
    echo "❌ [pre-commit hook] C/C++ format check failed! The following files require formatting:" >&2
    echo "$output" >&2
    echo "" >&2
    echo "💡 Run this command to fix:" >&2
    echo "    git clang-format --staged --style=file --extensions c,h,cpp,hpp,cc,cxx,c++,h++,hh" >&2
    return 1
  fi

  echo "✅ [pre-commit hook] C/C++ format check passed."
  return 0
}

check_python_format() {
  if ! command -v ruff &> /dev/null; then
    echo "⚠️  [pre-commit hook] Warning: ruff not found. Skipping Python format check." >&2
    return 0
  fi

  echo "🔍 [pre-commit hook] Checking Python format..."

  failed=0

  if ! ruff format --check --diff ./tools/ 2>&1; then
    failed=1
  fi

  if [[ $failed -eq 1 ]]; then
    echo "" >&2
    echo "💡 Run this command to fix:" >&2
    echo "    ruff format ./tools/" >&2
    return 1
  fi

  echo "✅ [pre-commit hook] Python format check passed."
  return 0
}

check_shell_format() {
  if ! command -v shfmt &> /dev/null; then
    echo "⚠️  [pre-commit hook] Warning: shfmt not found. Skipping Shell format check." >&2
    return 0
  fi

  echo "🔍 [pre-commit hook] Checking shell format..."

  # Google Shell Style Guide: https://google.github.io/styleguide/shellguide.html
  # -i 2: 2-space indent, -ci: indent switch cases, -bn: binary ops start line
  # -sr: space after redirects (improves readability; not required but compatible)

  if ! shfmt -f ./tools/ | xargs shfmt -d -i 2 -ci -bn -sr 2>&1; then
    echo "" >&2
    echo "💡 Run this command to fix:" >&2
    echo "    shfmt -f ./tools/ | xargs shfmt -w -i 2 -ci -bn -sr" >&2
    return 1
  fi

  echo "✅ [pre-commit hook] Shell format check passed."
  return 0
}

# ----------------------------------------------------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------------------------------------------------
echo "📝 [pre-commit hook] Running format checks..."
echo ""

exit_code=0

check_c_cpp_format || exit_code=1
echo ""

check_python_format || exit_code=1
echo ""

check_shell_format || exit_code=1
echo ""

if [[ $exit_code -eq 0 ]]; then
  echo "🎉 [pre-commit hook] All format checks passed."
else
  echo "💥 [pre-commit hook] Some checks failed. Fix the issues above before committing."
fi

exit $exit_code
