menu "Board Selection"

# Board name string - used by CMake to select board directory
config BOARD_NAME
    string
    default "nucleo_g431rb" if BOARD_NUCLEO_G431RB
    help
        Target board name (directory name in src/boards/)
        This value is read by CMake to select the correct board subdirectory.

choice
    prompt "Target Board"
    default BOARD_NUCLEO_G431RB
    help
        Select the target development board

config BOARD_NUCLEO_G431RB
    bool "NUCLEO-G431RB"
    select MCU_STM32G4
    help
        STM32 NUCLEO-G431RB development board

endchoice

# Load board-specific configuration based on selection
if BOARD_NUCLEO_G431RB
source "src/boards/nucleo_g431rb/Kconfig"
endif

endmenu
