#!/bin/bash
# stlink-usb - WSL-side ST-Link USB/IP manager
# Calls usbipd.exe via WSL interop, no need to open Windows PowerShell
#
# USAGE:
#   stlink-usb list     - List all USB devices
#   stlink-usb attach   - Auto-find and attach ST-Link (or: attach <BUSID>)
#   stlink-usb detach   - Detach ST-Link (or: detach <BUSID>)
#   stlink-usb status   - Quick status: is ST-Link attached to WSL?
#
# STATES (usbipd):
#   "Not shared"  - device visible, usbipd not bound
#   "Shared"      - usbipd bound, not attached to WSL
#   "Attached"    - attached to WSL (usable in /dev/bus/usb)

set -euo pipefail

USBIPD="/mnt/c/Program Files/usbipd-win/usbipd.exe"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

die() { echo -e "${RED}✗ $1${NC}" >&2; exit 1; }

check_usbipd() {
    [ -x "$USBIPD" ] || die "usbipd.exe not found at $USBIPD\n  Install: winget install dorssel.usbipd-win"
}

# --- Parse usbipd list output ---
# usbipd list output format (columns are variable width):
#   BUSID  VID:PID  DEVICE...  STATE
# STATE is always the last word(s): "Not shared" | "Shared" | "Attached" | "Attached - Windows"

get_devices() {
    # Returns connected devices (skip header + Persisted section)
    "$USBIPD" list 2>/dev/null | awk '/^Connected:/,/^Persisted:/' | tail -n +2 | head -n -1
}

# Extract state from a usbipd line (last 1-2 meaningful words)
parse_state() {
    local line="$1"
    # States: "Not shared", "Shared", "Attached", "Attached - Windows"
    if echo "$line" | grep -q "Attached - Windows"; then echo "Attached - Windows"
    elif echo "$line" | grep -q "Not shared"; then echo "Not shared"
    elif echo "$line" | grep -q "Shared"; then echo "Shared"
    elif echo "$line" | grep -q "Attached"; then echo "Attached"
    else echo "Unknown"
    fi
}

# Extract BUSID from a usbipd line (first field)
parse_busid() {
    echo "$1" | awk '{print $1}'
}

# Find ST-Link lines (VID 0483)
get_stlink_lines() {
    get_devices | grep '0483:' || true
}

# --- Commands ---

cmd_list() {
    check_usbipd
    echo -e "${CYAN}=== Connected USB Devices ===${NC}"
    "$USBIPD" list
}

cmd_attach() {
    check_usbipd
    local busid="${1:-}"

    if [ -z "$busid" ]; then
        # Find first ST-Link that is NOT attached
        local line
        line=$(get_stlink_lines | grep -v "Attached" | head -1)
        [ -n "$line" ] || die "No ST-Link ready to attach. Is it plugged in?\n  Run: stlink-usb list"
        busid=$(parse_busid "$line")
        echo -e "${GREEN}✓ Found ST-Link at ${busid}${NC}"
    fi

    # Check if already attached
    local line
    line=$(get_stlink_lines | grep "^${busid}" || true)
    local state
    state=$(parse_state "$line")

    if [ "$state" = "Attached" ]; then
        echo -e "${GREEN}✓ ${busid} already attached to WSL${NC}"
        return 0
    fi

    echo -e "${CYAN}Attaching ${busid} to WSL...${NC}"
    "$USBIPD" attach --wsl --busid="$busid" 2>&1 \
        || die "Attach failed. Try: stlink-usb detach ${busid} then attach again"

    # Verify
    sleep 1
    line=$(get_stlink_lines | grep "^${busid}" || true)
    state=$(parse_state "$line")
    if [ "$state" = "Attached" ]; then
        echo -e "${GREEN}✓ Successfully attached!${NC}"
    else
        echo -e "${YELLOW}⚠ Attach command succeeded but state is: ${state}${NC}"
    fi
}

cmd_detach() {
    check_usbipd
    local busid="${1:-}"

    if [ -z "$busid" ]; then
        local line
        line=$(get_stlink_lines | grep "Attached" | head -1)
        [ -n "$line" ] || die "No attached ST-Link found. Run: stlink-usb list"
        busid=$(parse_busid "$line")
    fi

    echo -e "${CYAN}Detaching ${busid}...${NC}"
    "$USBIPD" detach --busid="$busid" 2>&1 \
        || die "Detach failed"
    echo -e "${GREEN}✓ Detached${NC}"
}

cmd_status() {
    check_usbipd

    echo -e "${CYAN}=== ST-Link USB/IP Status ===${NC}"
    echo ""

    # Kernel module
    if lsmod 2>/dev/null | grep -qE "vhci_hcd|usbip"; then
        echo -e "  WSL USB/IP kernel: ${GREEN}loaded${NC}"
    else
        echo -e "  WSL USB/IP kernel: ${YELLOW}not loaded${NC} (will auto-load on attach)"
    fi

    # ST-Link devices
    local lines
    lines=$(get_stlink_lines)

    if [ -z "$lines" ]; then
        echo -e "  ST-Link: ${RED}not detected${NC} (not plugged in?)"
    else
        while IFS= read -r line; do
            local busid state
            busid=$(parse_busid "$line")
            state=$(parse_state "$line")

            if [ "$state" = "Attached" ]; then
                echo -e "  ST-Link ${busid}: ${GREEN}Attached to WSL ✓${NC}"
            elif [ "$state" = "Shared" ]; then
                echo -e "  ST-Link ${busid}: ${YELLOW}Shared (ready to attach)${NC}"
            else
                echo -e "  ST-Link ${busid}: ${YELLOW}${state}${NC}"
            fi
        done <<< "$lines"
    fi

    # /dev/bus/usb
    if [ -d /dev/bus/usb ] && ls /dev/bus/usb/*/* &>/dev/null 2>&1; then
        local count
        count=$(find /dev/bus/usb -mindepth 2 -type c 2>/dev/null | wc -l)
        echo -e "  /dev/bus/usb: ${GREEN}${count} device(s)${NC}"
    else
        echo -e "  /dev/bus/usb: ${YELLOW}empty${NC}"
    fi
}

# --- Main ---
case "${1:-help}" in
    list|ls)    cmd_list ;;
    attach|a)   cmd_attach "${2:-}" ;;
    detach|d)   cmd_detach "${2:-}" ;;
    status|s)   cmd_status ;;
    help|h|--help|-h)
        echo "stlink-usb - WSL-side ST-Link USB/IP manager"
        echo ""
        echo "USAGE:"
        echo "  stlink-usb list               List all USB devices"
        echo "  stlink-usb attach [BUSID]     Auto-find or specify ST-Link"
        echo "  stlink-usb detach [BUSID]     Detach ST-Link"
        echo "  stlink-usb status             Quick status check"
        ;;
    *) die "Unknown command: $1\n  Run: stlink-usb help" ;;
esac
